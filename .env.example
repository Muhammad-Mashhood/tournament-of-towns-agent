# Tournament of Towns Archive Agent — Environment Variables
# Copy this file to .env and fill in your key.
# NEVER commit .env to version control (it is in .gitignore).
# The key must never appear in code, logs, or generated PDFs.

# Your OpenRouter API key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-PASTE_YOUR_KEY_HERE

# Optional: override the hard $5 spending cap (default: 5.00)
# BUDGET_CAP_USD=5.00
